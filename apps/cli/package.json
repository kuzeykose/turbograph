{
  "name": "trbgraph",
  "version": "0.0.1",
  "description": "CLI tool to generate dependency graphs for Turborepo workspaces",
  "type": "module",
  "bin": {
    "trbgraph": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "glob": "^11.0.0",
    "minimatch": "^10.0.3",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "@workspace/graph": "workspace:*",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.7.3"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "turborepo",
    "monorepo",
    "dependency-graph",
    "cli"
  ],
  "license": "MIT",
  "author": "Kuzey Kose",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuzeykose/turbograph.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/kuzeykose/turbograph/tree/main/apps/cli"
}
