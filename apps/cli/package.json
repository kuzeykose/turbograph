{
  "name": "turbograph",
  "version": "0.0.1",
  "description": "CLI tool to generate dependency graphs for Turborepo workspaces",
  "type": "module",
  "bin": {
    "turbograph": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/graph": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "glob": "^11.0.0",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.7.3"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "turborepo",
    "monorepo",
    "dependency-graph",
    "cli"
  ],
  "license": "MIT"
}
